{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:best-practices",
		"github>aquaproj/aqua-renovate-config#2.14.0",
		"github>aquaproj/aqua-renovate-config:file#2.14.0(.aqua/.*\\.ya?ml)",
		"github>aquaproj/aqua-renovate-config:file#2.14.0(.aqua/pkgs/.*\\.ya?ml)"
	],
	"timezone": "Asia/Tokyo",
	"automerge": true,
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/^version.json$/"],
			"matchStrings": ["\"version\": \"(?<currentValue>.*?)\"\n"],
			"datasourceTemplate": "git-tags",
			"depNameTemplate": "passt",
			"packageNameTemplate": "https://passt.top/passt",
			"versioningTemplate": "regex:^(?<major>\\d{4})_(?<minor>\\d{2})_(?<patch>\\d{2})\\.[0-9a-f]+$"
		}
	]
}
